{
  "name": "decky-prystanok",
  "version": "0.0.1",
  "description": "Decky plugin that shows localization badges and warns about russian-developed/published games in the Steam library (powered by prystanok.com.ua API)",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "vitest run",
    "test:py": "python3 -m unittest discover -s tests"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "ukraine",
    "localization"
  ],
  "author": "ka3u6y6a",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "jsdom": "^29.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  }
}